DASHBOARD_DEBUG=1
DASHBOARD_SECRET_KEY=replace-this-for-non-local-use
DASHBOARD_ALLOWED_HOSTS=127.0.0.1,localhost
DASHBOARD_CSRF_TRUSTED_ORIGINS=
DASHBOARD_TRUST_PROXY_HEADERS=0
DASHBOARD_SECURE_COOKIES=0
DASHBOARD_TIME_ZONE=Asia/Kolkata
DASHBOARD_WORKSPACE_ROOT=/path/to/your/workspace
DOCUMENT_VIEWER_DEFAULT_DIRECTORY=/path/to/your/workspace
DASHBOARD_REPOSITORY_LIMIT=12
DASHBOARD_SERVICE_ENDPOINTS=Dashboard|http://127.0.0.1:8001/health/,Gringotts API|http://127.0.0.1:8000,Local App|http://127.0.0.1:3000
API_MOCKER_LEGACY_DATA_FILE=/path/to/dashboard/data/mocks.json
DASHBOARD_DATABASE_ENGINE=sqlite
SQLITE_DATABASE_PATH=/path/to/dashboard/data/dashboard.sqlite3
MYSQL_DATABASE=local_project_dashboard
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
PORT=8000
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
RUN_MIGRATIONS=1
